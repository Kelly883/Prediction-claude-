# Core Application
APP_URL=http://localhost:3000

# Cron & Background Jobs
# CRON_SECRET must be at least 32 characters. Use a strong random value in production.
CRON_SECRET=
RENEWAL_LOCK_TIMEOUT_SECONDS=900

# Database
# Production DATABASE_URL must use SSL/TLS (sslmode=require).
# DIRECT_URL is for Prisma migrations and should use a separate migration user if possible.
DATABASE_URL=
DIRECT_URL=

# Payment Providers
# Never commit real payment keys. Rotate immediately if exposed.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FX_CACHE_TTL_SECONDS=3600

# Authentication & JWT Secrets
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must be >= 32 characters.
# Use different secrets for access and refresh tokens.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
# Session idle timeout in milliseconds. Default: 24 hours (86400000).
# Users idle longer than this will be logged out on next refresh.
SESSION_IDLE_TIMEOUT_MS=86400000

# Application-Level Encryption Keys (32-byte / 64 hex characters)
# Used for encrypting sensitive data at rest. Rotate using key versioning (v1, v2).
PAYMENT_TOKEN_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
ENCRYPTION_KEY=

# Admin Bootstrap Security
# Required in production to prevent unauthorized admin creation.
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_SECRET=

# Email (Resend)
# Production: use a dedicated domain with SPF/DKIM/DMARC configured.
# If these are unset OR the RESEND_FROM_EMAIL domain isn't verified in your
# Resend account, registration/password-reset/verification emails silently
# fail to send (accounts still get created — check server logs for "Failed
# to send verification email" / "Resend send failed"). Users can request a
# fresh link anytime via POST /api/auth/resend-verification.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Object Storage (S3 / Cloudflare R2)
# Bucket must be private. Never make prediction media publicly accessible.
# Use short-lived signed URLs for client access.
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_SECRET_ACCESS_KEY=
# Signed URL TTL in seconds. Keep short (5-10 minutes) for security.
SIGNED_URL_TTL_SECONDS=300

# Redis (Upstash Rate Limiting & Caching)
# Use separate Redis database for production if possible.
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
