generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  email                   String                   @unique
  phone                   String?
  passwordHash            String
  country                 String
  role                    Role                     @default(user)
  twoFactorEnabled        Boolean                  @default(false)
  twoFactorSecret         String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  name                    String
  tokenVersion            Int                      @default(0)
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?                @db.Timestamp(6)
  emailVerifiedAt         DateTime?                @db.Timestamp(6)
  deletedAt               DateTime?                @db.Timestamp(6)
  permissions             String[]                 @default([])
  grantedAt               DateTime?                @db.Timestamp(6)
  grantedBy               String?
  lastLoginAt             DateTime?                @db.Timestamp(6)
  updatedAnalysisConfigs  AnalysisConfig[]         @relation("UpdatedAnalysisConfigs")
  reviewedAnalysisResults AnalysisResult[]         @relation("ReviewedAnalysisResults")
  auditLogs               AuditLog[]               @relation("AuditActor")
  cmsEdits                CmsSection[]
  complimentaryAccess     ComplimentaryAccess[]
  emailVerifications      EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  createdPosts            PredictionPost[]         @relation("PostCreator")
  subscriptions           Subscription[]
  transactions            Transaction[]
  recoveryCodes           TwoFactorRecoveryCode[]
  sessions                UserSession[]

  @@index([role])
  @@index([lockedUntil])
  @@index([permissions], type: Gin)
}

model Plan {
  id               String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name             String
  durationDays     Int
  priceNGN         Decimal        @db.Decimal(12, 2)
  priceUSDOverride Decimal?       @db.Decimal(12, 2)
  fxMarkupPercent  Decimal?       @db.Decimal(5, 2)
  accessScope      AccessScope    @default(all)
  categoryIds      String[]       @default([])
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  currency         Currency       @default(NGN)
  subscriptions    Subscription[]
  transactions     Transaction[]

  @@index([isActive])
}

model Subscription {
  id                    String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                String
  planId                String
  status                SubscriptionStatus @default(active)
  autoRenew             Boolean            @default(true)
  startAt               DateTime
  endAt                 DateTime
  renewalProvider       PaymentProvider?
  renewalAuthCode       String?
  renewalAttempts       Int                @default(0)
  lastRenewalError      String?
  renewalReminderSentAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  renewalStatus         RenewalStatus      @default(idle)
  renewalLockedAt       DateTime?
  renewalReference      String?
  billingObligationId   String?            @unique
  plan                  Plan               @relation(fields: [planId], references: [id])
  user                  User               @relation(fields: [userId], references: [id])
  transactions          Transaction[]

  @@index([userId, status, endAt])
  @@index([status, autoRenew, endAt, renewalStatus])
}

model Transaction {
  id                    String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                String
  subscriptionId        String?
  planId                String?
  provider              PaymentProvider
  providerReference     String            @unique
  amount                Decimal           @db.Decimal(12, 2)
  currency              Currency
  fxRateUsed            Decimal?          @db.Decimal(12, 6)
  status                TransactionStatus @default(pending)
  idempotencyKey        String            @unique
  rawPayload            Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  completedAt           DateTime?
  providerTransactionId String?
  obligationId          String?           @unique
  previousEndAt         DateTime?
  resultingEndAt        DateTime?
  plan                  Plan?             @relation(fields: [planId], references: [id])
  subscription          Subscription?     @relation(fields: [subscriptionId], references: [id])
  user                  User              @relation(fields: [userId], references: [id])

  @@unique([provider, providerTransactionId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([obligationId])
}

model PredictionPost {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  title               String
  scheduledAt         DateTime
  categoryIds         String[]              @default([])
  bookingCode         String
  bodyNotes           String?
  visibility          PostVisibility        @default(subscribers)
  freeUntil           DateTime?
  planIds             String[]              @default([])
  status              PostStatus            @default(draft)
  createdById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  outcome             OutcomeStatus         @default(pending)
  analysisResult      AnalysisResult?
  complimentaryAccess ComplimentaryAccess[]
  media               MediaAsset[]
  items               PredictionItem[]
  createdBy           User                  @relation("PostCreator", fields: [createdById], references: [id])

  @@index([status, scheduledAt])
  @@index([outcome, status])
}

model PredictionItem {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId        String
  match         String
  prediction    String
  matchDateTime DateTime?
  post          PredictionPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model MediaAsset {
  id               String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId           String
  storageKey       String
  watermarkEnabled Boolean        @default(true)
  createdAt        DateTime       @default(now())
  post             PredictionPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model FreeAccessRule {
  id        String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  type      FreeAccessRuleType
  trialDays Int?
  startAt   DateTime?
  endAt     DateTime?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())

  @@index([isActive, type])
}

model ComplimentaryAccess {
  id        String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  postId    String?
  expiresAt DateTime?
  createdAt DateTime        @default(now())
  post      PredictionPost? @relation(fields: [postId], references: [id], onDelete: Restrict)
  user      User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([action, createdAt])
}

model CmsSection {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  page        String
  key         String
  content     Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  @@unique([page, key])
}

model UserSession {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String
  deviceFingerprint String
  ip                String?
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId, lastSeenAt])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamp(6)
  usedAt    DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnalysisRun {
  id               String            @id @default(uuid())
  runDate          DateTime          @db.Date
  status           AnalysisRunStatus @default(pending)
  fixturesAnalyzed Int               @default(0)
  picksGenerated   Int               @default(0)
  startedAt        DateTime?         @db.Timestamp(6)
  completedAt      DateTime?         @db.Timestamp(6)
  errorMessage     String?
  createdAt        DateTime          @default(now()) @db.Timestamp(6)
  updatedAt        DateTime          @updatedAt @db.Timestamp(6)
  checkpoint       Json?
  attempts         Int               @default(0)
  results          AnalysisResult[]

  @@index([runDate, status])
}

model AnalysisResult {
  id                    String          @id @default(uuid())
  runId                 String
  fixtureId             String
  homeTeam              String
  awayTeam              String
  league                String
  kickoff               DateTime        @db.Timestamp(6)
  bestMarket            MarketType
  bestSelection         String
  bestOdds              Decimal?        @db.Decimal(6, 2)
  confidence            Decimal         @db.Decimal(5, 2)
  marketScores          Json
  topFactors            Json
  status                ResultStatus    @default(pending)
  reviewedById          String?
  reviewedAt            DateTime?       @db.Timestamp(6)
  dismissalReason       String?
  predictionPostId      String?         @unique
  createdAt             DateTime        @default(now()) @db.Timestamp(6)
  updatedAt             DateTime        @updatedAt @db.Timestamp(6)
  enrichmentQuality     String?
  providerSource        String?
  missingDataFields     Json?
  marketEligibility     Json?
  marketExclusionReason String?
  fixtureStatus         String?
  seasonId              String?
  oddsSource            String?
  oddsCapturedAt        DateTime?
  predictionPost        PredictionPost? @relation(fields: [predictionPostId], references: [id])
  reviewedBy            User?           @relation("ReviewedAnalysisResults", fields: [reviewedById], references: [id])
  run                   AnalysisRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, fixtureId])
  @@index([runId])
  @@index([confidence])
  @@index([status])
  @@index([enrichmentQuality])
  @@index([seasonId])
}

model AnalysisConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedById String
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)
  updatedBy   User     @relation("UpdatedAnalysisConfigs", fields: [updatedById], references: [id])
}

model LeagueConfig {
  id            String   @id @default(uuid())
  leagueName    String   @unique
  leagueCode    String   @unique
  isEnabled     Boolean  @default(true)
  priority      Int      @default(1)
  marketWeights Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @db.Timestamp(6)
}

enum Role {
  admin
  user
  superadmin
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

enum RenewalStatus {
  idle
  processing
  failed
  reconciliation_required
}

enum PaymentProvider {
  paystack
  flutterwave
}

enum Currency {
  NGN
  USD
}

enum TransactionStatus {
  pending
  success
  failed
  processing
  cancelled
}

enum AccessScope {
  all
  category
}

enum PostVisibility {
  plan_specific
  subscribers
  free_window
}

enum PostStatus {
  draft
  scheduled
  published
  archived
}

enum OutcomeStatus {
  pending
  won
  lost
}

enum FreeAccessRuleType {
  global_trial
  promo_window
}

enum AnalysisRunStatus {
  pending
  running
  completed
  failed
  deferred
}

enum MarketType {
  MATCH_RESULT
  BTTS
  OVER_UNDER_2_5
  ASIAN_HANDICAP
  DOUBLE_CHANCE
  CORRECT_SCORE
  FIRST_HALF_RESULT
  TOTAL_CORNERS
  TOTAL_CARDS
  PLAYER_SCORER
}

enum ResultStatus {
  pending
  approved
  dismissed
  published
}
