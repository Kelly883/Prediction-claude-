# Core Application
# APP_URL may be a full URL (https://predictpro.online) or bare domain (predictpro.online).
APP_URL=http://localhost:3000

# Cron & Background Jobs
# CRON_SECRET must be at least 32 characters. Use a strong random value in production.
CRON_SECRET=
RENEWAL_LOCK_TIMEOUT_SECONDS=900
API_FOOTBALL_KEY=
FOOTBALL_DATA_API_KEY=
FOOTBALL_API_TIMEOUT_MS=10000
FOOTBALL_CACHE_TTL_SECONDS=86400

# Database
# Production DATABASE_URL must use SSL/TLS (sslmode=require).
# DIRECT_URL is for Prisma migrations and should use a separate migration user if possible.
DATABASE_URL=
DIRECT_URL=

# Payment Providers
# Never commit real payment keys. Rotate immediately if exposed.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FX_CACHE_TTL_SECONDS=3600

# Authentication & JWT Secrets
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must be >= 32 characters.
# Use different secrets for access and refresh tokens.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
# Session idle timeout in milliseconds. Default: 24 hours (86400000).
# Users idle longer than this will be logged out on next refresh.
SESSION_IDLE_TIMEOUT_MS=86400000

# Application-Level Encryption Keys (32-byte / 64 hex characters)
# Used for encrypting sensitive data at rest. Rotate using key versioning (v1, v2).
PAYMENT_TOKEN_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
ENCRYPTION_KEY=

# Admin Bootstrap Security
# Required in production to prevent unauthorized admin creation.
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_SECRET=

# Email (Resend)
# REQUIRED FOR PRODUCTION DELIVERY:
# 1. Verify the RESEND_FROM_EMAIL domain in your Resend dashboard.
# 2. Add the SPF/DKIM/DMARC DNS records Resend provides for that domain.
# 3. Use a dedicated domain, not a free/shared one, for best deliverability.
#
# Resend returning 200/accepted does NOT mean the email reached the inbox.
# If users report "not received", check:
#   - Resend dashboard → Domains → is the domain verified?
#   - Resend dashboard → Emails → does the email show "Delivered" or "Bounced"/"Spam"?
#   - recipient spam/junk/promotions folder
#   - SPF/DKIM/DMARC records in DNS
#   - server logs for "[email]" warnings at startup about domain mismatch
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Object Storage (S3 / Cloudflare R2)
# Bucket must be private. Never make prediction media publicly accessible.
# Use short-lived signed URLs for client access.
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_SECRET_ACCESS_KEY=
# Signed URL TTL in seconds. Keep short (5-10 minutes) for security.
SIGNED_URL_TTL_SECONDS=300

# Redis (Upstash Rate Limiting & Caching)
# Use separate Redis database for production if possible.
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=

# Provider Protection (Phase 1)
# INTERNAL SAFETY LIMITS — NOT the provider's published plan entitlements.
# These bound ALL API-Football traffic (including retries) across every serverless
# instance via a shared distributed limiter. Set conservatively; never raise them
# on an assumption about plan capacity. All values are optional; defaults shown.
PROVIDER_RPS=4
PROVIDER_RPM=240
PROVIDER_MAX_WAIT_MS=10000
PROVIDER_MAX_SLEEP_MS=1000
# Independent Football-Data.org distributed limiter (SEPARATE keys/limits from
# API-Football). Defaults are pinned to the DOCUMENTED FREE-PLAN CEILING
# (10 requests/minute) because the account's paid entitlement is NOT verified.
# Do not raise without an authorized live probe confirming the entitlement.
FOOTBALL_DATA_RPS=1
FOOTBALL_DATA_RPM=10
FOOTBALL_DATA_MAX_WAIT_MS=10000
FOOTBALL_DATA_MAX_SLEEP_MS=1000
# Daily-quota consumption thresholds (ratio 0..1). 70% warn / 85% critical / 95% stop.
PROVIDER_QUOTA_WARNING_THRESHOLD=0.7
PROVIDER_QUOTA_CRITICAL_THRESHOLD=0.85
PROVIDER_QUOTA_STOP_THRESHOLD=0.95
# How long a quota snapshot is trusted before it is treated as STALE (seconds).
PROVIDER_QUOTA_FRESHNESS_SECONDS=1800
# TTL applied to the stored quota snapshot in Redis (seconds).
PROVIDER_QUOTA_SNAPSHOT_TTL_SECONDS=86400
# Behaviour when quota cannot be determined: 'block' (fail closed, default) or 'warn'.
PROVIDER_QUOTA_UNKNOWN_POLICY=block
# Fixture-enrichment concurrency (still bounded by the global limiter).
PROVIDER_ENRICHMENT_CONCURRENCY=10
# Execution-time budget for the daily analysis run: a single invocation checkpoints
# and defers the remainder when this wall-clock ceiling is reached (must stay below
# the route's maxDuration). PROVIDER_ANALYSIS_BATCH_SIZE fixtures per durable batch.
PROVIDER_ANALYSIS_MAX_RUNTIME_MS=240000
PROVIDER_ANALYSIS_BATCH_SIZE=25
# Distributed single-flight cache lock.
PROVIDER_SINGLE_FLIGHT_LOCK_TTL_MS=15000
PROVIDER_SINGLE_FLIGHT_WAIT_MS=18000
PROVIDER_SINGLE_FLIGHT_POLL_MS=150
# Circuit breaker (existing): failure threshold / window / cooldown (seconds).
PROVIDER_CIRCUIT_THRESHOLD=5
PROVIDER_CIRCUIT_WINDOW_SECONDS=120
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
# Bounded retry (existing).
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=500
PROVIDER_RETRY_MAX_MS=8000
